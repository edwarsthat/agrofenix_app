{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://localhost:3000/login"
        },
        {
          "url": "http://localhost:3000/cambiar-password"
        },
        {
          "url": "http://192.168.0.200:3000/login"
        },
        {
          "url": "http://192.168.0.200:3000/cambiar-password"
        }
      ]
    }
  ]
}